# --- Configuration de Production (Quran-LLM) ---

# Provider : 'ollama' ou 'openai' (pour Groq/Gemini/OpenAI)
LLM_PROVIDER=openai
EMBEDDINGS_PROVIDER=openai

# API Key de Production (Ex: Groq API Key)
LLM_API_KEY=gsk_votre_cle_groq_ici

# URLs de Production (Ex: Groq)
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
EMBEDDINGS_BASE_URL=https://api.groq.com/openai/v1/embeddings

# Modeles de Production (Ex: Llama 3)
LLM_MODEL=llama-3.3-70b-versatile
LLM_TRANSLATION_MODEL=llama-3.1-8b-instant
EMBEDDINGS_MODEL=nomic-embed-text-v1.5

# Parametres
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
EMBEDDINGS_CANDIDATE_POOL=20
